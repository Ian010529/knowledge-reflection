  <graph edgedefault="undirected">
    <node id="PRG_9e58569c757c">
      <data key="d0">用取向离子通道解耦 TG 凝胶的机械强度与红氧扩散</data>
      <data key="d1">direct_TG_precedent_upgrade_candidate</data>
      <data key="d2">False</data>
    </node>
    <node id="PRG_3680dde71847">
      <data key="d0">用 pH 响应两性离子凝胶放大并可逆切换 Q/HQ TG 极性</data>
      <data key="d1">new_cross_mechanism_hypothesis</data>
      <data key="d2">False</data>
    </node>
    <node id="PRG_e948eab97497">
      <data key="d0">把固定正电荷通道与分子识别结合，做 I−/I3− TG 选择性隔层</data>
      <data key="d1">mechanism_extension_white_space</data>
      <data key="d2">False</data>
    </node>
    <node id="PRG_e34db5baa25d">
      <data key="d0">用聚合物配位强度调节 Cu/Cu2+ TG 的溶剂化熵与扩散</data>
      <data key="d1">direct_TG_precedent_upgrade_candidate</data>
      <data key="d2">False</data>
    </node>
    <node id="PRG_0d4cbb7dc34c">
      <data key="d0">用阴离子缠结调节 Fe2+/Fe3+ TG 的支持离子热扩散项</data>
      <data key="d1">mechanism_extension_white_space</data>
      <data key="d2">False</data>
    </node>
    <node id="PRG_88a7efad7dbd">
      <data key="d0">测试多阳离子链的 Manning 凝聚能否区分 3−/4− 红氧阴离子</data>
      <data key="d1">mechanism_extension_white_space</data>
      <data key="d2">False</data>
    </node>
    <node id="PRG_cf22ac785fee">
      <data key="d0">把 iTE 低凝固混合溶剂迁移到 Co 配合物准固态 TG</data>
      <data key="d1">direct_TG_precedent_upgrade_candidate</data>
      <data key="d2">False</data>
    </node>
    <node id="PRG_0f7a0b8392d8">
      <data key="d0">在 TG 电极前构建 Donnan 界面层，调节 3−/4− 局部活度与动力学</data>
      <data key="d1">direct_TG_precedent_upgrade_candidate</data>
      <data key="d2">False</data>
    </node>
    <node id="PRG_08afbdcdbb17">
      <data key="d0">把水热扩散驱动的质子定向输运叠加到 Q/HQ 热电化学反应</data>
      <data key="d1">direct_TG_precedent_upgrade_candidate</data>
      <data key="d2">False</data>
    </node>
    <node id="PRG_17b64f2815f3">
      <data key="d0">用 iTE 离子–电子耦合启发 Fe2+/Fe3+ TG 的局部混合导体电极</data>
      <data key="d1">direct_TG_precedent_upgrade_candidate</data>
      <data key="d2">False</data>
    </node>
    <node id="PRG_4e691dc1cea3">
      <data key="d0">在薄层 TG 中加入取向滑移纳米通道，提高短路电流而非只追求电压</data>
      <data key="d1">mechanism_extension_white_space</data>
      <data key="d2">False</data>
    </node>
    <node id="PRG_4cca4840d8f1">
      <data key="d0">用可调疏水微区选择性分配 I3−，同时兼顾 TG 凝胶韧性</data>
      <data key="d1">direct_TG_precedent_upgrade_candidate</data>
      <data key="d2">False</data>
    </node>
    <node id="PRG_00699a1a9edc">
      <data key="d0">用可切换 Soret 单元为 I−/I3− TG 构建等效 p/n 腿</data>
      <data key="d1">direct_TG_precedent_upgrade_candidate</data>
      <data key="d2">False</data>
    </node>
    <node id="PRG_791da0044d52">
      <data key="d0">把温差诱导的渗透浓度势与 TG 红氧电势串联，而非只做单一机制</data>
      <data key="d1">direct_TG_precedent_upgrade_candidate</data>
      <data key="d2">False</data>
    </node>
    <node id="PRG_55d2dd45b552">
      <data key="d0">把 EHD 离子均匀化工艺扩展为 TG 凝胶的空间分区打印</data>
      <data key="d1">direct_TG_precedent_upgrade_candidate</data>
      <data key="d2">False</data>
    </node>
    <node id="PRG_086c824d735e">
      <data key="d0">正对照：蒸发冷却与浓缩可同时增强 TG 的 ΔT 和活度差</data>
      <data key="d1">known_TG_precedent_positive_control</data>
      <data key="d2">True</data>
    </node>
    <node id="PRG_bee069aa7a26">
      <data key="d0">正对照：α-CD/I3− 主–客体作用已能直接进入 I−/I3− TG</data>
      <data key="d1">known_TG_precedent_positive_control</data>
      <data key="d2">True</data>
    </node>
    <node id="PRG_be2befc69363">
      <data key="d0">正对照：冠醚增强 K+ 热扩散，可与 ferri/ferrocyanide TG 电压叠加</data>
      <data key="d1">known_TG_precedent_positive_control</data>
      <data key="d2">True</data>
    </node>
    <node id="PRG_a4dbfa46d1fd">
      <data key="d0">正对照：把 iTE 的阴离子胶束固定迁移为 TG 中 I3− 的温敏捕获/释放</data>
      <data key="d1">known_TG_precedent_positive_control</data>
      <data key="d2">True</data>
    </node>
    <node id="PRG_99097fe0f5e3">
      <data key="d0">正对照：热释电负责瞬态、TG 负责稳态的双时间尺度收能</data>
      <data key="d1">known_TG_precedent_positive_control</data>
      <data key="d2">True</data>
    </node>
